{
  // Provider và Model mặc định sử dụng.
  // ★ Giá trị "provider" là một con trỏ (pointer) trỏ tới một key trong danh sách "providers" bên dưới.
  //   Trong TUI, bạn có thể dùng lệnh /config để quản lý Provider/Model và /model để chuyển đổi nhanh.
  "provider": "openrouter",
  "model": "google/gemini-2.5-flash",

  // (Tùy chọn) Mức độ suy luận (reasoning effort): off / low / medium / high / xhigh / max.
  // Bỏ trống hoặc không khai báo = giữ nguyên mặc định của mô hình/nhà cung cấp.
  "reasoning_effort": "medium",

  // Ngôn ngữ sáng tác nội dung tiểu thuyết: "vi" (Tiếng Việt, mặc định) hoặc "zh" (Tiếng Trung).
  // Dù chọn ngôn ngữ sáng tác nào, toàn bộ giao diện TUI luôn hiển thị bằng Tiếng Việt.
  "language": "vi",

  // Danh mục cấu hình nhà cung cấp AI (Provider).
  // Các provider được hỗ trợ sẵn: openai, anthropic, gemini, openrouter, deepseek, qwen, glm, grok, mimo, ollama, bedrock.
  // Đối với proxy tùy chỉnh, bạn cần chỉ định thêm trường "type" (openai/anthropic/gemini).
  "providers": {
    // 1. Ollama Cục bộ (Chạy offline trên máy tính, hoàn toàn miễn phí)
    "ollama": {
      // Khi chạy trực tiếp từ máy: "http://localhost:11434/v1"
      // Khi chạy qua Docker trên Windows/macOS: "http://host.docker.internal:11434/v1"
      // Lưu ý: Endpoint OpenAI-compatible của Ollama bắt buộc phải có đuôi /v1
      "base_url": "http://localhost:11434/v1",
      // Không bắt buộc phải có api_key đối với Ollama
      "models": [
        { "name": "qwen2.5:14b", "context_window": 65536 },
        { "name": "ainovel-qwen", "context_window": 65536 }
      ],
      // Thời gian chờ stream rảnh rỗi (Go duration, mặc định "5m"):
      // Với mô hình local chạy trên máy cấu hình vừa phải, có thể đặt "15m" để không bị timeout khi suy luận dài.
      "stream_idle_timeout": "15m"
    },

    // 2. OpenRouter (Truy cập hầu hết các mô hình Claude, Gemini, DeepSeek, Qwen qua 1 API key)
    "openrouter": {
      "api_key": "sk-or-v1-YOUR_OPENROUTER_KEY",
      "base_url": "https://openrouter.ai/api/v1",
      "models": [
        { "name": "google/gemini-2.5-flash", "context_window": 200000 },
        { "name": "google/gemini-2.5-pro", "context_window": 1000000 },
        { "name": "anthropic/claude-3.5-sonnet", "context_window": 200000 },
        { "name": "deepseek/deepseek-chat", "context_window": 64000 }
      ],
      // (Tùy chọn) Tham số bổ sung gửi kèm theo mỗi request (temperature, top_p, min_p...)
      "extra_body": { "temperature": 0.8, "min_p": 0.05 }
    },

    // 3. Anthropic Claude chính hãng
    "anthropic": {
      "api_key": "sk-ant-YOUR_ANTHROPIC_KEY",
      "models": [
        { "name": "claude-3-5-sonnet-20241022", "context_window": 200000, "json_schema": true }
      ]
    },

    // 4. Google Gemini chính hãng
    "gemini": {
      "api_key": "YOUR_GEMINI_API_KEY",
      "models": [
        { "name": "gemini-2.5-flash", "context_window": 200000 },
        { "name": "gemini-2.5-pro", "context_window": 1000000 }
      ]
    },

    // 5. DeepSeek API chính hãng
    "deepseek": {
      "api_key": "sk-YOUR_DEEPSEEK_KEY",
      "models": [
        { "name": "deepseek-chat", "context_window": 64000 },
        { "name": "deepseek-reasoner", "context_window": 64000 }
      ]
    },

    // 6. OpenAI chính hãng
    "openai": {
      "api_key": "sk-YOUR_OPENAI_KEY",
      "models": [
        { "name": "gpt-4o", "context_window": 128000 },
        { "name": "gpt-4o-mini", "context_window": 128000 }
      ]
    }
  },

  // (Tùy chọn) Cấu hình phân vai mô hình (Multi-Agent Role Mapping).
  // Các vai trò:
  // - "architect": Kiến trúc sư (Lên dàn ý, phân cảnh, thế giới, nhân vật)
  // - "writer": Người viết (Chấp bút chi tiết từng chương)
  // - "editor": Biên tập viên (Đánh giá, phản biện, kiểm tra chất lượng)
  // "roles": {
  //   "architect": { "provider": "openrouter", "model": "google/gemini-2.5-pro" },
  //   "editor": { "provider": "openrouter", "model": "google/gemini-2.5-pro" },
  //   "writer": {
  //     "provider": "ollama",
  //     "model": "ainovel-qwen",
  //     "fallbacks": [{ "provider": "openrouter", "model": "deepseek/deepseek-chat" }]
  //   }
  // },

  // Phong cách sáng tác mặc định: "default" / "fantasy" / "romance" / "suspense"
  "style": "default"

  // (Tùy chọn) Cửa sổ ngữ cảnh toàn cục phiên bản cũ (fallback nếu không cấu hình trong models).
  // "context_window": 65536,

  // (Tùy chọn) Hạn mức ngân sách tối đa cho một cuốn sách (tính bằng USD).
  // "budget": {
  //   "book_usd": 10.0,
  //   "warn_ratio": 0.8,
  //   "hard_stop": false
  // },

  // (Tùy chọn) Thông báo hệ thống khi hoàn thành hoặc có sự cố.
  // "notify": {
  //   "enabled": true,
  //   // Unix: $NOTIFY_TITLE; Windows PowerShell: $env:NOTIFY_TITLE
  //   // "command": "curl -s -G --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"message=$NOTIFY_BODY\" ntfy.sh/<topic>/publish",
  //   "events": ["run_end", "budget", "advance_gate", "stop_guard", "plan_start", "deadlock", "worker_failure"]
  // }
}
